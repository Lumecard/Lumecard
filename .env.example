# Lumecard client settings. Copy to .env.local for local work, and set the same names in Vercel
# (Project Settings > Environment Variables). Only variables starting with VITE_ reach the browser,
# so NEVER put a secret here. Everything below is public by design.

# Which Stellar network the app talks to: testnet (default) or mainnet.
# On testnet nothing else is needed. On mainnet EVERY value below must be set, or the app refuses to
# start and says which one is missing, so a test address can never be used by mistake.
VITE_STELLAR_NETWORK=testnet

# --- Needed on mainnet (testnet has built-in defaults) ---
# Soroban RPC address from your provider (there is no free public default on mainnet).
# VITE_SOROBAN_RPC_URL=
# Horizon address. Defaults to https://horizon.stellar.org on mainnet.
# VITE_HORIZON_URL=
# The deployed Lumecard gift contract (starts with C).
# VITE_GIFT_CONTRACT=
# Token contracts on this network (start with C).
# VITE_XLM_CONTRACT=
# VITE_USDC_CONTRACT=
# VITE_EURC_CONTRACT=
# Token issuers (start with G). Take these from Circle's own documentation, and check them twice.
# VITE_USDC_ISSUER=
# VITE_EURC_ISSUER=
# Lumecard's wallet: receives the Mix fee, and must be a funded account that has enabled USDC.
# VITE_FEE_ADDRESS=

# --- Optional ---
# Free project id from https://cloud.reown.com so mobile wallets (Varial, Freighter mobile, Lobstr) can connect.
# VITE_WALLETCONNECT_PROJECT_ID=
